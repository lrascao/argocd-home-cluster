# Hard limits on the whole account's orders that open risk: every strategy's
# together, and the desk's. Closing orders always go through. Each strategy
# also has its own, tighter limits in strategies/<id>.toml. The adapter
# enforces both whatever the agents' instructions say, and get_status shows
# these to every agent. broker-ibkr/broker_ibkr/limits.py is what reads them.
#
# Until every LIMIT_ below except the kill switch has a value, the adapter
# opens nothing. The numbers are yours to choose. A change here rolls the
# broker pod (the ConfigMap name carries a hash of this file), which strands
# the agents until the Catalyst fix for re-attaching MCP servers ships
# (README.md, "Restarting the broker").
#
# Money is in EUR. A loss is worked out in USD from the legs and converted at
# IBKR's own EUR/USD rate; until IBKR has sent it, nothing opens.
#
# LIMIT_UNDERLYINGS=                 comma-separated tickers any strategy may trade, e.g. SPY,QQQ
# LIMIT_MAX_LOSS_PER_ORDER=          EUR: worst loss at expiry of one opening order
# LIMIT_MAX_OPEN_RISK=               EUR: worst loss of all positions and working opening orders
# LIMIT_MAX_OPENING_ORDERS_PER_DAY=  per UTC day, all strategies, counting refused and cancelled ones
# LIMIT_MAX_DAILY_LOSS=              EUR: IBKR's P&L for the day, for the whole account
# LIMIT_MIN_DAYS_TO_EXPIRY=
# LIMIT_MAX_DAYS_TO_EXPIRY=

# true: nothing opens, for any strategy; closes still go through. One
# strategy alone is stopped with kill_switch in its own file.
# LIMIT_KILL_SWITCH=true

LIMIT_KILL_SWITCH=false

LIMIT_UNDERLYINGS=SPY,QQQ
LIMIT_MAX_LOSS_PER_ORDER=1000
# Room for both strategies' budgets (2 x 2,500).
LIMIT_MAX_OPEN_RISK=5000
# Both strategies' daily limits (2 x 6).
LIMIT_MAX_OPENING_ORDERS_PER_DAY=12
LIMIT_MAX_DAILY_LOSS=1000
LIMIT_MIN_DAYS_TO_EXPIRY=7
LIMIT_MAX_DAYS_TO_EXPIRY=60
