# Hard limits on every order that opens risk; closing orders always go
# through. The adapter enforces these whatever the agent's instructions say,
# and get_status shows them to the agent. broker-ibkr/broker_ibkr/limits.py
# is what reads them.
#
# Until every LIMIT_ below except the kill switch has a value, the adapter
# opens nothing. The numbers are yours to choose. A change here rolls the
# broker pod (the ConfigMap name carries a hash of this file).
#
# LIMIT_UNDERLYINGS=                 comma-separated tickers it may trade, e.g. SPY,QQQ
# LIMIT_MAX_LOSS_PER_ORDER=          USD: worst loss at expiry of one opening order
# LIMIT_MAX_OPEN_RISK=               USD: worst loss of all positions and working opening orders
# LIMIT_MAX_OPENING_ORDERS_PER_DAY=  per UTC day, counting refused and cancelled ones
# LIMIT_MAX_DAILY_LOSS=              account BASE currency (EUR), IBKR's P&L for the day
# LIMIT_MIN_DAYS_TO_EXPIRY=
# LIMIT_MAX_DAYS_TO_EXPIRY=

# true: nothing opens, closes still go through. Turn it off once the numbers
# above are set and you have watched a few runs.
LIMIT_KILL_SWITCH=true
